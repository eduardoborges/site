---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/jetbrains-mono';
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: {
    publishedTime: string;
    tags?: string[];
  };
}

const { title, description, ogImage, article } = Astro.props;
const siteTitle = 'Eduardo';
const pageTitle = title === siteTitle ? siteTitle : `${title} - ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname.replace(/\/$/, '') === '/en';
const defaultDescription = isEn
  ? "eduardo borges' site — software engineer, from bahia, former vaqueiro."
  : 'site do eduardo borges — engenheiro de software, baiano, ex-vaqueiro.';
---

<!DOCTYPE html>
<html lang={isEn ? "en" : "pt-BR"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {isHome && <link rel="alternate" hreflang="pt-BR" href={new URL('/', Astro.site)} />}
  {isHome && <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />}
  {isHome && <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />}
  <meta name="description" content={description || defaultDescription} />
  <meta name="author" content="Eduardo Borges" />

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description || defaultDescription} />
  <meta property="og:locale" content={isEn ? "en_US" : "pt_BR"} />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}
  {article && <meta property="article:published_time" content={article.publishedTime} />}
  {article?.tags?.map(tag => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description || defaultDescription} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

  <!-- Preconnect -->
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://tools.borges.workers.dev" />
  <link rel="dns-prefetch" href="https://tools.borges.workers.dev" />
</head>
<body>
  <a href="#main-content" class="skip-link">pular para o conteúdo</a>
  <div class="content">
    <Header />
    <div id="main-content">
      <slot />
    </div>
    <Footer />
  </div>

  <script>
    // wght-hover: mesmo efeito de peso do título, mas guiado pelo cursor —
    // letras perto do mouse engordam e decaem com a distância.
    // fallback: sem hover (touch) ou reduced-motion, nada muda.
    if (
      matchMedia('(hover: hover)').matches &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const R = 60;
      const MAX = 800;
      for (const el of document.querySelectorAll<HTMLElement>('h1, h2, h3, a')) {
        if (el.matches('.hero h1')) continue; // o título já tem a onda própria
        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) nodes.push(walker.currentNode as Text);
        const chars: HTMLSpanElement[] = [];
        for (const node of nodes) {
          const frag = document.createDocumentFragment();
          for (const ch of node.textContent ?? '') {
            if (!ch.trim()) {
              frag.append(ch);
              continue;
            }
            const s = document.createElement('span');
            s.className = 'wght-char';
            s.textContent = ch;
            frag.append(s);
            chars.push(s);
          }
          node.replaceWith(frag);
        }
        if (!chars.length) continue;
        const base = parseInt(getComputedStyle(el).fontWeight) || 400;
        el.addEventListener('pointermove', (e) => {
          for (const s of chars) {
            const r = s.getBoundingClientRect();
            const d = Math.hypot(
              e.clientX - r.left - r.width / 2,
              e.clientY - r.top - r.height / 2,
            );
            // sqrt: platô pesado perto do cursor, queda brusca na borda do raio
            const t = Math.sqrt(Math.max(0, 1 - d / R));
            // no hover o elemento inteiro afina pra 100 e só a zona do cursor
            // engorda até 800 — mesma amplitude da onda do título
            s.style.fontVariationSettings = `'wght' ${Math.round(100 + (MAX - 100) * t)}`;
          }
        });
        el.addEventListener('pointerleave', () => {
          for (const s of chars) s.style.fontVariationSettings = `'wght' ${base}`;
        });
      }
    }
  </script>

  <!-- gtag deferred -->
  <script is:inline>
    window.addEventListener('load', function() {
      setTimeout(function() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-9MMLCJ5CMK';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-9MMLCJ5CMK');
      }, 2000);
    });
  </script>
</body>
</html>
